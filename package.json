{
  "name": "@cocreate/speech-recognition",
  "version": "1.0.0",
  "description": "Declarative speech-to-text for CoCreate using the browser SpeechRecognition API.",
  "keywords": [
    "speech-recognition",
    "speech-to-text",
    "dictation",
    "transcription",
    "web-speech-api",
    "accessibility",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Declarative speech-to-text for CoCreate using the browser SpeechRecognition API.",
      "source": "src/index.js",
      "declarative": {
        "selectors": [
          "[speech-recognition-query], [speech-recognition]"
        ],
        "attributes": [
          {
            "name": "actions"
          },
          {
            "name": "aria-disabled"
          },
          {
            "name": "speech-recognition"
          },
          {
            "name": "speech-recognition-active"
          },
          {
            "name": "speech-recognition-alternatives"
          },
          {
            "name": "speech-recognition-lang"
          },
          {
            "name": "speech-recognition-query"
          }
        ]
      },
      "api": {
        "exports": [
          "abort",
          "init",
          "start",
          "stop",
          "toggle"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-speech-recognition.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-speech-recognition/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/speech-recognition",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/actions": "^1.24.0",
    "@cocreate/observer": "^1.23.0",
    "@cocreate/utils": "^1.54.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/observer@1.19.0": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}
